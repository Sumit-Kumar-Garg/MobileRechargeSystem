<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Replaces the release file of the same name. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Plain HTTP to the backend on the developer's machine, and nowhere else. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>   <!-- the host machine, seen from the emulator -->
        <domain includeSubdomains="false">localhost</domain>  <!-- a real phone with: adb reverse tcp:8080 tcp:8080 -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
