# Copy to .env and adjust. .env is git-ignored: put real secrets there (or in your secret manager), never here.
# Docker Compose reads .env automatically. For `./mvnw spring-boot:run`, export the variables in your shell.
# Every variable is optional locally: the defaults shown are what the app and compose files use without it.

# --- Infrastructure (docker-compose.yml) ---------------------------------------------------------------------
DB_NAME=recharge
DB_USER=recharge
DB_PASSWORD=recharge              # change for anything but local development
DB_PORT=5432
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk   # never change once the kafkadata volume exists
KAFKA_LOG_RETENTION_HOURS=168
REDIS_PORT=6379
# REDIS_PASSWORD: empty = no password (local only); set it everywhere else
REDIS_PASSWORD=
LB_PORT=8000                      # docker-compose.cluster.yml load balancer

# --- App: connections ------------------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=demo       # demo = seed data + dev secrets + mock providers. NEVER in production
DB_URL=jdbc:postgresql://localhost:5432/recharge
DB_POOL_SIZE=10                   # per instance
DB_CONNECTION_TIMEOUT_MS=3000
KAFKA_BOOTSTRAP=localhost:9092
REDIS_HOST=localhost
MANAGEMENT_PORT=8081              # health and metrics, not exposed publicly

# --- App: secrets (required outside the demo profile) --------------------------------------------------------
# JWKS_URI: production: identity provider's JWKS endpoint
JWKS_URI=
JWT_AUDIENCE=
JWT_ISSUER=recharge-demo
# JWT_SECRET: demo/tests only, >= 32 bytes, used when JWKS_URI is empty
JWT_SECRET=
# PII_AES_KEY: base64 of exactly 32 bytes:  openssl rand -base64 32
PII_AES_KEY=
PII_AES_KEY_ID=1
# PII_HMAC_KEY: base64 of >= 32 bytes:       openssl rand -base64 32
PII_HMAC_KEY=

# --- App: several instances ------------------------------------------------------------------------------------
RATE_LIMIT_STORE=memory           # memory (one instance) | redis (required with more than one instance)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=120
PLANS_CACHE_SPEC=maximumSize=500,expireAfterWrite=5m
PLANS_CACHE_REFRESH_ENABLED=true
PLANS_CACHE_REFRESH_DELAY=PT10S   # ISO-8601
WORKERS_ENABLED=true

# --- App: abuse protection and limits (durations: 1m, 1h, 1d; sizes: 16KB) ----------------------------------
# Per-endpoint limits, per user (or IP when anonymous). Each has a _LIMIT (requests) and a _WINDOW.
RATE_LIMIT_ORDERS_CREATE_LIMIT=10
RATE_LIMIT_ORDERS_CREATE_WINDOW=1h
RATE_LIMIT_ORDERS_PAY_LIMIT=10
RATE_LIMIT_ORDERS_PAY_WINDOW=1h
RATE_LIMIT_NUMBERS_LINK_LIMIT=5
RATE_LIMIT_NUMBERS_LINK_WINDOW=1d
RATE_LIMIT_RECOMMENDATIONS_LIMIT=20
RATE_LIMIT_RECOMMENDATIONS_WINDOW=1h
RATE_LIMIT_TELEMETRY_LIMIT=60
RATE_LIMIT_TELEMETRY_WINDOW=1m
RATE_LIMIT_DEVICES_PUT_LIMIT=20
RATE_LIMIT_DEVICES_PUT_WINDOW=1h
RATE_LIMIT_DEVICES_DELETE_LIMIT=20
RATE_LIMIT_DEVICES_DELETE_WINDOW=1h
# Card-testing lockout: FAILED_PAYMENTS_MAX declined payments per FAILED_PAYMENTS_WINDOW
FAILED_PAYMENTS_MAX=5
FAILED_PAYMENTS_WINDOW=1h
# Largest request body. Raising REQUEST_MAX_TELEMETRY_BODY also needs client_max_body_size in deploy/nginx.conf
REQUEST_MAX_BODY=16KB
REQUEST_MAX_TELEMETRY_BODY=256KB
NUMBERS_MAX_PER_USER=3
NOTIFICATION_MAX_SMS_PER_DAY=5
NOTIFICATION_MAX_ACTIVE_DEVICES=5

# --- App: business rules ---------------------------------------------------------------------------------------
ORDER_TTL=15m
ORDER_MAX_PAYMENT_ATTEMPTS=3
PROVISIONING_MAX_ATTEMPTS=3
PROVISIONING_STALE_AFTER=2m
PROVISIONING_BASE_BACKOFF=5s

# --- App: schedules (ISO-8601 durations, e.g. PT15S, PT15M) -----------------------------------------------------
PROVISIONING_WORKER_DELAY=PT15S
RECONCILIATION_DELAY=PT60S
RECONCILIATION_PENDING_MIN_AGE=60s
# RECONCILIATION_NOT_FOUND_GRACE: wait before voiding a charge the PSP does not know. Shorter = double-charge risk
RECONCILIATION_NOT_FOUND_GRACE=10m
RECONCILIATION_LEASE=5m
CATALOG_SYNC_DELAY=PT15M
CATALOG_SYNC_INITIAL_DELAY=PT10S
OUTBOX_PUBLISHER_DELAY=PT1S
RETENTION_CRON="0 30 3 * * *"

# --- App: external providers -----------------------------------------------------------------------------------
PSP_MODE=none                     # none | mock (demo/tests)
PSP_TIMEOUT=10s
PSP_MAX_CONCURRENT=50
OCS_MODE=none                     # none | mock (demo/tests)
OCS_TIMEOUT=10s
OCS_MAX_CONCURRENT=30
PAYMENT_PROVIDER_PRIORITY=mockpay,altpay
ALTPAY_ENABLED=false
TRAVELSIM_ENABLED=false
NOTIFICATION_PROVIDER=log

# --- App: thread pools, Kafka, shutdown ------------------------------------------------------------------------
PROVISIONING_EXECUTOR_CORE_SIZE=2
PROVISIONING_EXECUTOR_MAX_SIZE=8
PROVISIONING_EXECUTOR_QUEUE_CAPACITY=200
KAFKA_ENABLED=true
KAFKA_PARTITIONS=6
KAFKA_REPLICAS=1                  # production: 3
OUTBOX_PUBLISHER_ENABLED=true
SHUTDOWN_TIMEOUT=20s

# --- App: AI advisor -------------------------------------------------------------------------------------------
ADVISOR_LLM=none                  # none | openai-compatible | scripted (demo/tests)
ADVISOR_LLM_BASE_URL=
# ADVISOR_LLM_API_KEY: secret
ADVISOR_LLM_API_KEY=
ADVISOR_LLM_MODEL=
ADVISOR_MAX_STEPS=6
ADVISOR_CALL_TIMEOUT=20s
ADVISOR_MAX_CONCURRENT=10
ADVISOR_MAX_OUTPUT_TOKENS=400
ADVISOR_ADVICE_TTL=24h
ADVISOR_RUNS_PER_USER_PER_DAY=5

# --- App: observability and API docs ---------------------------------------------------------------------------
TRACE_SAMPLING=0.1
OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OPENAPI_ENABLED=false
